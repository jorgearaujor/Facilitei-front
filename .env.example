# ==========================================================================
# BUILD DO FRONTEND (Vite) — unicas variaveis que entram no bundle publicado.
# Em producao (Vercel) defina estas no painel do projeto, nunca secrets aqui.
# Em desenvolvimento, deixe VAZIAS: o proxy do Vite encaminha /api e o
# WebSocket para a API local (http://localhost:8080).
# ==========================================================================

# No modo "proxy pelo Vercel" (ver vercel.json), o front chama /api na mesma
# origem e o Vercel repassa para a API no Railway (https://facilitei.velika.com.br).
# Nesse modo, deixe VAZIO.
# So preencha com a URL absoluta (https://.../api) se for usar dominio proprio
# e chamada cross-origin direta.
VITE_API_URL=

# URL do WebSocket (STOMP) do chat. No modo proxy o chat nao funciona (o Vercel
# nao faz proxy de WS); passa a funcionar com dominio proprio.
# Ex.: wss://api.SEU-DOMINIO/buildrun-livechat-websocket
VITE_WS_URL=

# ==========================================================================
# STACK LOCAL VIA DOCKER COMPOSE (compose.yml) — NAO vao para o bundle do Vite.
# Servem apenas para subir API + MySQL + Mailpit + front localmente.
# ==========================================================================

# Contas com acesso ao painel /admin (separe por virgula).
APP_ADMIN_EMAILS=

# Web Push (VAPID) — gere um par exclusivo por ambiente:
#   npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@facilitei.app

# Pagamentos recorrentes (backend)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MONTHLY_AMOUNT_CENTS=2990
MERCADOPAGO_REASON=Facilitei - plano profissional

# Armazenamento de imagens (backend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_ENDPOINT=
