# Gere um par VAPID exclusivo para cada ambiente e nunca versione a chave privada.
# Exemplo com npx: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@facilitei.app

# Contas já cadastradas que terão acesso ao painel /admin (separe por vírgula).
APP_ADMIN_EMAILS=

# Pagamentos recorrentes (backend)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MONTHLY_AMOUNT_CENTS=2990
MERCADOPAGO_REASON=Facilitei - plano profissional

# Armazenamento de imagens (backend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_ENDPOINT=
